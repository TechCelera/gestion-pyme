auto-install-peers=true

# Con pnpm cada import del código fuente debe estar en dependencies/devDependencies
# (no basta con que npm lo “subiera” antes por hoisting).

# Evita que `pnpm install` ejecute scripts de build de paquetes no listados en package.json
# (configuración explícita en package.json → pnpm.onlyBuiltDependencies).
