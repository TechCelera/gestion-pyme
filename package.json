{
  "name": "gestion-pyme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest",
    "test:run": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest run",
    "test:ui": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest --ui",
    "test:coverage": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest --coverage",
    "test:e2e": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test",
    "test:e2e:ci": "env -u PLAYWRIGHT_SKIP_WEBSERVER NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright test",
    "test:e2e:operaciones": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test e2e/authenticated/operaciones-flows.spec.ts",
    "test:e2e:ui": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --ui",
    "test:e2e:running": "pnpm run test:e2e",
    "test:e2e:list": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright test --list",
    "playwright:install": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright install chromium-headless-shell",
    "playwright:install:full": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright install chromium",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "verify:all": "pnpm run verify && pnpm run test:e2e:ci",
    "verify:all:local": "pnpm run verify && pnpm run test:e2e",
    "verify:trial": "bash scripts/trial-verify.sh",
    "check:readiness": "node scripts/check-company-readiness.mjs",
    "wipe:contacts": "node scripts/wipe-contacts.mjs",
    "wipe:dev": "node scripts/wipe-dev-data.mjs",
    "seed:defaults": "node scripts/seed-company-defaults.mjs",
    "seed:matias-demo": "node scripts/seed-matias-demo.mjs",
    "admin:set-password": "node scripts/admin-set-password.mjs",
    "sb": "node scripts/supabase-cli.mjs",
    "sb:version": "node scripts/supabase-cli.mjs --version",
    "sb:login": "node scripts/supabase-cli.mjs login",
    "sb:projects": "node scripts/supabase-cli.mjs projects list",
    "sb:push:dry": "node scripts/supabase-cli.mjs db push --dry-run",
    "sb:push": "node scripts/supabase-cli.mjs db push",
    "vercel": "vercel",
    "vercel:env": "vercel env ls",
    "vercel:deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@serwist/next": "^9.5.7",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "serwist": "^9.5.7",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^52.0.1",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.0",
      "tar": ">=7.5.11",
      "minimatch": ">=10.2.3",
      "undici": ">=6.24.0",
      "postcss": ">=8.5.10",
      "path-to-regexp": ">=8.4.0",
      "smol-toml": ">=1.6.1",
      "srvx": ">=0.11.13",
      "@tootallnate/once": ">=3.0.1",
      "@vercel/static-config>ajv": ">=8.18.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "msw",
      "unrs-resolver"
    ]
  }
}
