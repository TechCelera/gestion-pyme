{
  "name": "gestion-pyme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest",
    "test:run": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest run",
    "test:ui": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest --ui",
    "test:coverage": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" vitest --coverage",
    "test:e2e": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test",
    "test:e2e:ci": "env -u PLAYWRIGHT_SKIP_WEBSERVER NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright test",
    "test:e2e:ui": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --ui",
    "test:e2e:running": "pnpm run test:e2e",
    "test:e2e:list": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright test --list",
    "playwright:install": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright install chromium-headless-shell",
    "playwright:install:full": "NODE_OPTIONS=\"${NODE_OPTIONS:+${NODE_OPTIONS} }--disable-warning=DEP0205\" playwright install chromium",
    "verify": "pnpm run lint && pnpm run test:run && pnpm run build",
    "verify:all": "pnpm run verify && pnpm run test:e2e:ci",
    "verify:all:local": "pnpm run verify && pnpm run test:e2e",
    "sb": "supabase",
    "sb:version": "supabase --version",
    "sb:login": "supabase login",
    "sb:projects": "supabase projects list",
    "sb:push:dry": "supabase db push --dry-run",
    "sb:push": "supabase db push"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@serwist/next": "^9.5.7",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "serwist": "^9.5.7",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.3",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "jsdom": "^29.0.2",
    "supabase": "2.98.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.0"
    },
    "onlyBuiltDependencies": [
      "supabase",
      "sharp",
      "msw",
      "unrs-resolver"
    ]
  }
}
