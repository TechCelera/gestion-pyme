# Supabase (required for auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional: borrar usuarios de Auth al eliminar del equipo (server-only, nunca en el cliente)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública de la app (invitaciones, recuperación de contraseña)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E — usuario dedicado en el mismo proyecto Supabase (email confirmado)
# Sin estas variables, los specs en e2e/authenticated/ se omiten en local/CI.
E2E_TEST_EMAIL=e2e@example.com
E2E_TEST_PASSWORD=your-secure-test-password

# Playwright (optional)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1
