# Supabase (required for auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (scripts check:readiness, auth.admin). Nunca en el cliente.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase → Project Settings → Database → password (requerido para pnpm sb:push)
# SUPABASE_DB_PASSWORD=your-database-password

# URL pública de la app (invitaciones, recuperación, emailRedirectTo en registro)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Producción (gamma): https://gestion-pyme-gamma.vercel.app

# E2E — usuario dedicado en el mismo proyecto Supabase (email confirmado)
# Sin estas variables, los specs en e2e/authenticated/ se omiten en local/CI.
E2E_TEST_EMAIL=e2e@example.com
E2E_TEST_PASSWORD=your-secure-test-password

# Demo Matías Distribuidora — login normal con cuenta precargada (/login)
# Provisionar: pnpm run seed:matias-demo
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=1
NEXT_PUBLIC_DEMO_EMAIL=matias-demo@gestion-pyme.app
NEXT_PUBLIC_DEMO_PASSWORD=DemoMatias2026!
# Alias para el script seed (mismos valores)
DEMO_EMAIL=matias-demo@gestion-pyme.app
DEMO_PASSWORD=DemoMatias2026!
DEMO_OPERATOR_EMAIL=operador-matias-demo@gestion-pyme.app
DEMO_OPERATOR_PASSWORD=DemoMatias2026!
# E2E piloto Matías (opcional; por defecto usa DEMO_* de arriba)
# E2E_MATIAS_ADMIN_EMAIL=matias-demo@gestion-pyme.app
# E2E_MATIAS_ADMIN_PASSWORD=DemoMatias2026!
# E2E_MATIAS_OPERATOR_EMAIL=operador-matias-demo@gestion-pyme.app
# E2E_MATIAS_OPERATOR_PASSWORD=DemoMatias2026!

# Playwright (optional)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1
